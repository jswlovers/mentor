# 통화(보이스톡/페이스톡): https://dashboard.daily.co 에서 API 키 발급. 없으면 통화 요청이 501로 응답한다.
DAILY_API_KEY=

# 토스페이먼츠 결제 승인 API (선택). 없으면 무통장입금 + 관리자 수동승인 흐름만 쓴다.
TOSS_SECRET_KEY=


# 데모 전용: 새 회원에게 처음 한 번 지급할 코인. 운영에서는 비워둔다.
DEMO_SIGNUP_COINS=

# 관리자 지정: 가입 후 서버에서 npm run make-admin -- <아이디>

# HTTPS 직접 서비스(포트 PORT). 두 경로가 모두 있으면 server.mjs가 HTTPS로 뜬다.
PORT=3000
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# 카카오 알림톡 / 문자 (Solapi). 비워두면 mock(서버 로그에만 출력).
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
KAKAO_PF_ID=
# 종류별 알림톡 템플릿 ID (docs/admin-manual 2-7장의 문구로 심사 후 입력)
KAKAO_TEMPLATE_NEW_MESSAGE=
KAKAO_TEMPLATE_EXPERT_JOINED=
KAKAO_TEMPLATE_ANSWER_RECEIVED=
KAKAO_TEMPLATE_CHARGE_APPROVED=
KAKAO_TEMPLATE_CHARGE_REJECTED=
KAKAO_TEMPLATE_EXPERT_APPROVED=
KAKAO_TEMPLATE_EXPERT_REJECTED=
KAKAO_TEMPLATE_WITHDRAW_PAID=
KAKAO_TEMPLATE_TICKET_RESOLVED=
KAKAO_TEMPLATE_ADMIN_NOTICE=
KAKAO_TEMPLATE_ADMIN_ALERT=
# solapi 로 두면 문자·인증번호를 실제로 발송한다 (기본 mock)
SMS_PROVIDER=
# 개발용: 1이면 mock일 때 인증번호를 화면에 표시. 운영에서는 비워둔다.
SMS_DEV_ECHO=

# 사업자 정보(전자상거래법 필수 표시). 모든 화면 하단에 표시된다. 바꾼 뒤 npm run build 다시 실행.
BUSINESS_NAME=
BUSINESS_CEO=
BUSINESS_REG_NO=
BUSINESS_ECOMMERCE_NO=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# DB·업로드 자동 백업. 서버가 켜져 있는 동안 주기마다 VACUUM INTO 스냅샷 + 업로드 파일 증분 복사.
# BACKUP_DIR 은 가능하면 다른 디스크(또는 동기화 폴더)로 지정한다. 기본 data/backups
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# 1이면 자동 백업을 끈다 (테스트 서버용)
BACKUP_DISABLED=

# 검색엔진·공유 미리보기용 실제 서비스 주소 (예: https://beautysos.kr). sitemap.xml·robots.txt·대표 주소에 쓰인다.
SITE_URL=
# 구글 서치콘솔 / 네이버 서치어드바이저 소유 확인 meta 값(content 부분만)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
