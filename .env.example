# 통화(보이스톡/페이스톡): https://dashboard.daily.co 에서 API 키 발급. 없으면 통화 요청이 501로 응답한다.
DAILY_API_KEY=

# 토스페이먼츠 결제 승인 API (선택). 없으면 무통장입금 + 관리자 수동승인 흐름만 쓴다.
TOSS_SECRET_KEY=


# 데모 전용: 새 회원에게 처음 한 번 지급할 코인. 운영에서는 비워둔다.
DEMO_SIGNUP_COINS=

# 관리자 지정: 가입 후 서버에서 npm run make-admin -- <아이디>

# HTTPS 직접 서비스(포트 PORT). 두 경로가 모두 있으면 server.mjs가 HTTPS로 뜬다.
PORT=3000
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
